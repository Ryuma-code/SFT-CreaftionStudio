// --- State Management ---
String currentSessionId = "";
unsigned long scheduledCaptureAt = 0;
enum LidState { STATE_CLOSED, STATE_OPEN, STATE_WAITING_TO_CLOSE };
LidState currentLidState = STATE_CLOSED;
